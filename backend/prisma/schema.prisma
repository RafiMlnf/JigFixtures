// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// MASTER DATA
// ==========================================

model Role {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "PE_JIG_FIXTURE", "PE_SECTION_HEAD", "PE_DEPT_HEAD", "TAMU"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("role")
}

model User {
  id                    String         @id @default(cuid())
  name                  String
  npk                   String         @unique
  email                 String         @unique
  password              String         // hashed password
  roleId                String         @map("role_id")
  role                  Role           @relation(fields: [roleId], references: [id])
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  inventoryLogs         InventoryLog[]
  notifications         Notification[]
  submittedApprovals    Approval[]     @relation("SubmittedBy")
  sectionApprovals      Approval[]     @relation("SectionHead")
  deptApprovals         Approval[]     @relation("DeptHead")
  reportedAbnormalities Abnormality[]  @relation("ReportedAbnormalities")
  revisionHistories     RevisionHistory[]

  @@map("user")
}

model Line {
  id        String   @id @default(cuid())
  lineName  String   @map("line_name")
  lineCode  String   @map("line_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  designs   Design[]

  @@map("line")
}

model Process {
  id        String   @id @default(cuid())
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  designs   Design[]

  @@map("process")
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  designs           Design[]
  revisionHistories RevisionHistory[]

  @@map("vendor")
}

// ==========================================
// TRANSACTIONAL DATA
// ==========================================

model Design {
  id                String         @id @default(cuid())
  noReg             String         @unique @map("no_reg")
  type              DesignType     @default(JF)
  noItem            String         @map("no_item")
  qty               String
  revStatus         String?        @map("rev_status") // "0", "1", "2", "N/A"
  
  lineId            String         @map("line_id")
  line              Line           @relation(fields: [lineId], references: [id])
  processId         String         @map("process_id")
  process           Process        @relation(fields: [processId], references: [id])
  vendorId          String?        @map("vendor_id")
  vendor            Vendor?        @relation(fields: [vendorId], references: [id])

  inventoryStatus   String         @default("GREEN") @map("inventory_status") // RED / YELLOW / GREEN
  abnormalityStatus String         @default("RESOLVED") @map("abnormality_status") // OPEN / IN_PROGRESS / RESOLVED
  lifecycleStatus   LifecycleStatus @default(ACTIVE) @map("lifecycle_status")

  // Extra fields to keep inventory and 3D features functional
  assyPartName      String         @map("assy_part_name")
  minimumStock      Int            @default(0) @map("minimum_stock")
  actualStock       Int            @default(0) @map("actual_stock")
  designDateLast    DateTime?      @map("design_date_last")
  designDateNew     DateTime?      @map("design_date_new")
  newVisualDesign   String?        @map("new_visual_design")
  lifetimeDays      Int            @default(180) @map("lifetime_days")
  lifetimeType      String         @default("DUAL") @map("lifetime_type") // DUAL / USAGE / DAYS
  maxUsage          Int            @default(500) @map("max_usage") // Batas aus siklus pemakaian (default 500x)
  currentUsage      Int            @default(0) @map("current_usage") // Counter pemakaian aktual

  // TPM Scheduling — kapan lifetime jig ini akan diatur di modul TPM
  tpmScheduleStart  DateTime? @map("tpm_schedule_start")   // Tanggal mulai masuk jadwal TPM
  tpmScheduleDeadline DateTime? @map("tpm_schedule_deadline") // Deadline harus sudah di-set lifetime di TPM
  tpmLifetimeSetAt  DateTime? @map("tpm_lifetime_set_at")  // Waktu lifetime sudah di-set di TPM (null = belum)

  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  documents         Document[]
  approvals         Approval[]
  abnormalities     Abnormality[]
  inventoryLogs     InventoryLog[]
  notifications     Notification[]
  revisionHistories RevisionHistory[]
  cellParts         CellPart[]
  tpmChecklists     TpmChecklist[]
  tpmLogs           TpmMaintenanceLog[]
  replacementLogs   PartReplacementLog[]

  @@map("design")
}

enum DesignType {
  JF
  EQ
}

model Document {
  id             String         @id @default(cuid())
  designId       String         @map("design_id")
  design         Design         @relation(fields: [designId], references: [id])
  path2D         String?        @map("2d_path")
  loc2D          String?        @map("2d_loc")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  approvalStatus String         @default("APPROVED") @map("approval_status")

  @@map("document")
}

model RevisionHistory {
  id             String   @id @default(cuid())
  designId       String   @map("design_id")
  design         Design   @relation(fields: [designId], references: [id])
  revStatus      String   @map("rev_status")
  description    String
  changedById    String   @map("changed_by_id")
  changedBy      User     @relation(fields: [changedById], references: [id])
  
  vendorId       String?  @map("vendor_id")
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
  poNumber       String?  @map("po_number")
  leadTime       Int?     @map("lead_time")
  approvedByName String?  @map("approved_by_name")
  path3D         String?  @map("3d_path")
  loc3D          String?  @map("3d_loc")
  path2D         String?  @map("2d_path")
  loc2D          String?  @map("2d_loc")

  createdAt      DateTime @default(now()) @map("created_at")

  @@map("revision_history")
}

model Abnormality {
  id               String            @id @default(cuid())
  designId         String            @map("design_id")
  design           Design            @relation(fields: [designId], references: [id])
  reportedById     String            @map("reported_by_id")
  reportedBy       User              @relation("ReportedAbnormalities", fields: [reportedById], references: [id])
  type             String            // RUSAK / AUS / DEFORMASI / LAINNYA
  description      String
  status           AbnormalityStatus @default(OPEN)
  
  dateFound        DateTime          @default(now()) @map("date_found")
  foundBy          String            @map("found_by")
  rootCause        String            @map("root_cause")
  tempAction       String            @map("temp_action")
  correctiveAction String            @map("corrective_action")
  actionPic        String            @map("action_pic")
  linkToRevision   Boolean           @default(false) @map("link_to_revision")
  linkToSpare      Boolean           @default(false) @map("link_to_spare")

  resolvedAt       DateTime?         @map("resolved_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@map("abnormality")
}

enum AbnormalityStatus {
  OPEN
  MONITORING
  CLOSED
}

model InventoryLog {
  id            String         @id @default(cuid())
  designId      String         @map("design_id")
  design        Design         @relation(fields: [designId], references: [id])
  changedById   String         @map("changed_by_id")
  changedBy     User           @relation(fields: [changedById], references: [id])
  prevMinStock  Int            @map("prev_min_stock")
  newMinStock   Int            @map("new_min_stock")
  prevActStock  Int            @map("prev_act_stock")
  newActStock   Int            @map("new_act_stock")
  indicator     String         // RED / YELLOW / GREEN
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("inventory_log")
}

model Notification {
  id        String          @id @default(cuid())
  type      String          // INVENTORY_RED / INVENTORY_YELLOW / WAITING_APPROVAL / ABNORMALITY_OPEN
  title     String
  message   String
  isRead    Boolean         @default(false) @map("is_read")
  designId  String?         @map("design_id")
  design    Design?         @relation(fields: [designId], references: [id])
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("notification")
}

model Approval {
  id             String         @id @default(cuid())
  type           ApprovalType
  status         ApprovalStatus @default(WAITING)
  designId       String         @map("design_id")
  design         Design         @relation(fields: [designId], references: [id])
  revisionNote   String?        @map("revision_note")

  submittedById  String         @map("submitted_by_id")
  submittedBy    User           @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime       @default(now()) @map("submitted_at")

  sectionHeadId  String?        @map("section_head_id")
  sectionHead    User?          @relation("SectionHead", fields: [sectionHeadId], references: [id])
  sectionStatus  ApprovalStatus @default(WAITING) @map("section_status")
  sectionComment String?        @map("section_comment")
  sectionAt      DateTime?      @map("section_at")

  deptHeadId     String?        @map("dept_head_id")
  deptHead       User?          @relation("DeptHead", fields: [deptHeadId], references: [id])
  deptStatus     ApprovalStatus @default(WAITING) @map("dept_status")
  deptComment    String?        @map("dept_comment")
  deptAt         DateTime?      @map("dept_at")

  finalStatus    ApprovalStatus @default(WAITING) @map("final_status")
  finalComment   String?        @map("final_comment")

  annotatedDocPath String?      @map("annotated_doc_path")
  markupData       String?      @map("markup_data")

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@map("approval")
}

enum ApprovalType {
  DESIGN_REVISION
  INVENTORY_UPDATE
}

enum ApprovalStatus {
  WAITING
  APPROVED
  REJECTED
}

enum LifecycleStatus {
  ACTIVE
  UNDER_REPAIR
  UNDER_IMPROVEMENT
  OBSOLETE
  SCRAP
}

// ==========================================
// CELL PART (Child of Design/Jig)
// ==========================================

model CellPart {
  id              String    @id @default(cuid())
  designId        String    @map("design_id")
  design          Design    @relation(fields: [designId], references: [id], onDelete: Cascade)

  partNumber      String    @map("part_number")
  name            String
  description     String?
  material        String?
  qty             String?   @default("1")

  // Lifetime tracking
  lifetimeDays    Int       @default(180) @map("lifetime_days")
  lifetimeType    String    @default("DUAL") @map("lifetime_type") // DUAL / USAGE / DAYS
  maxUsage        Int       @default(500) @map("max_usage") // Batas aus siklus pemakaian (default 500x)
  currentUsage    Int       @default(0) @map("current_usage") // Counter pemakaian aktual
  installDate     DateTime  @default(now()) @map("install_date")
  lastRenewalDate DateTime? @map("last_renewal_date")
  reminderSent    Boolean   @default(false) @map("reminder_sent")

  // Stock
  minimumStock    Int       @default(0) @map("minimum_stock")
  actualStock     Int       @default(0) @map("actual_stock")

  // PDF drawing page reference
  pdfPageIndex    Int?      @map("pdf_page_index")

  // TPM Scheduling — kapan lifetime cell part ini akan diatur di modul TPM
  tpmScheduleStart    DateTime? @map("tpm_schedule_start")
  tpmScheduleDeadline DateTime? @map("tpm_schedule_deadline")
  tpmLifetimeSetAt    DateTime? @map("tpm_lifetime_set_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tpmChecklists   TpmChecklist[]
  tpmLogs         TpmMaintenanceLog[]
  replacementLogs PartReplacementLog[]

  @@map("cell_part")
}

// ==========================================
// TPM (TOTAL PRODUCTIVE MAINTENANCE)
// ==========================================

model TpmChecklist {
  id                String       @id @default(cuid())
  designId          String       @map("design_id")
  design            Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  cellPartId        String?      @map("cell_part_id")
  cellPart          CellPart?    @relation(fields: [cellPartId], references: [id], onDelete: SetNull)

  inspectorName     String       @map("inspector_name")
  shift             String       @default("Shift 1") // Shift 1, Shift 2, Shift 3, Non-Shift
  checkDate         DateTime     @default(now()) @map("check_date")
  overallResult     String       @default("OK") @map("overall_result") // OK, NG

  cleaningStatus    String       @default("OK") @map("cleaning_status") // OK, NG, NA
  locatorPinStatus  String       @default("OK") @map("locator_pin_status") // OK, NG, NA
  clampingStatus    String       @default("OK") @map("clamping_status") // OK, NG, NA
  sensorStatus      String       @default("OK") @map("sensor_status") // OK, NG, NA
  boltsStatus       String       @default("OK") @map("bolts_status") // OK, NG, NA
  lubricationStatus String       @default("OK") @map("lubrication_status") // OK, NG, NA

  notes             String?
  linkToAbnormality Boolean      @default(false) @map("link_to_abnormality")
  abnormalityId     String?      @map("abnormality_id")

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("tpm_checklist")
}

model TpmMaintenanceLog {
  id                String       @id @default(cuid())
  designId          String       @map("design_id")
  design            Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  cellPartId        String?      @map("cell_part_id")
  cellPart          CellPart?    @relation(fields: [cellPartId], references: [id], onDelete: SetNull)

  actionType        String       @default("PREVENTIVE") @map("action_type") // PREVENTIVE, CORRECTIVE, RENEWAL, CALIBRATION, OVERHAUL
  title             String
  description       String
  performedBy       String       @map("performed_by")
  performedAt       DateTime     @default(now()) @map("performed_at")
  durationMinutes   Int?         @default(60) @map("duration_minutes")
  partsReplaced     String?      @map("parts_replaced")
  status            String       @default("COMPLETED") // COMPLETED, IN_PROGRESS, SCHEDULED
  resetLifetime     Boolean      @default(false) @map("reset_lifetime")

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("tpm_maintenance_log")
}

model PartReplacementLog {
  id              String    @id @default(cuid())
  designId        String    @map("design_id")
  design          Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  cellPartId      String?   @map("cell_part_id")
  cellPart        CellPart? @relation(fields: [cellPartId], references: [id], onDelete: SetNull)

  partNumber      String    @map("part_number")
  partName        String    @map("part_name")
  replacedAt      DateTime  @default(now()) @map("replaced_at")
  replacedBy      String    @map("replaced_by")
  reason          String
  notes           String?
  usageAtReplace  Int?      @map("usage_at_replace")
  daysUsed        Int?      @map("days_used")

  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("part_replacement_log")
}

